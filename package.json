{
  "name": "kintsugi",
  "private": true,
  "version": "0.1.0",
  "description": "Kintsugi: an installable app for learning Japanese kanji and vocabulary from kana to JLPT N1.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "run-s typecheck:app typecheck:node",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "budget": "size-limit",
    "lighthouse": "node scripts/lighthouse.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "verify": "run-s typecheck lint format:check test:unit build budget lighthouse test:e2e placeholders",
    "fonts:build": "node scripts/fonts/subset.mjs",
    "qa:screenshots": "node scripts/qa/screenshots.mjs",
    "data:fetch": "tsx --tsconfig tsconfig.node.json scripts/data/fetch.ts",
    "data:build": "tsx --tsconfig tsconfig.node.json scripts/data/build.ts",
    "data:verify": "tsx --tsconfig tsconfig.node.json scripts/data/verify.ts",
    "data:spotcheck": "tsx --tsconfig tsconfig.node.json scripts/data/spotcheck.ts",
    "data:update": "run-s data:fetch data:build data:verify data:spotcheck"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "dexie": "4.4.6",
    "dexie-export-import": "4.4.1",
    "dexie-react-hooks": "4.4.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.182.0",
    "ts-fsrs": "5.4.2",
    "wanakana": "5.3.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sax": "1.2.7",
    "@types/three": "0.182.0",
    "@types/unbzip2-stream": "1.4.3",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "lighthouse": "13.5.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "sax": "1.6.1",
    "size-limit": "14.1.0",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "unbzip2-stream": "1.4.3",
    "undici": "8.11.2",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
